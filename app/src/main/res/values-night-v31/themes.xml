<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ dark mode: same splash, light system-bar icons on the
         dark background. Kept separate from values-v31 because night is a
         higher-priority qualifier. -->
    <style name="Theme.Midtrack" parent="Base.Theme.Midtrack">
        <item name="android:windowSplashScreenBackground">@color/ss_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowSplashScreenAnimationDuration">200</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
